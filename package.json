{
  "name": "atlas-plugins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "sdk",
    "create-plugin",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build -w @atlas/plugin-sdk && npm run build -w @atlas/plugin-example-widget && npm run build -w @atlas/plugin-disk-manager && npm run build -w @atlas/plugin-math",
    "build:sdk": "npm run build -w @atlas/plugin-sdk",
    "typecheck": "tsc -p sdk/tsconfig.json --noEmit",
    "catalog": "node scripts/build-catalog.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
